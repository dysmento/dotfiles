#!/bin/bash
{{ if .isArch -}}
set -euo pipefail

if command -v yay &>/dev/null; then
    AUR_HELPER=yay
elif command -v paru &>/dev/null; then
    AUR_HELPER=paru
else
    echo "No AUR helper found (yay or paru). Cannot install packages." >&2
    exit 1
fi

# System & CLI tooling
cli_packages=(
    1password
    1password-cli
    acli-bin
    age
    alsa-lib
    atuin
    aws-cli-v2
    azure-cli
    mise
    usage
    babashka-bin
    bat
    bazelisk
    chezmoi
    clj-kondo-bin
    cloc
    clojure
    clojure-lsp-bin
    direnv
    docker
    docker-compose
    dolt
    eksctl
    emacs
    eza
    fd
    figlet
    fish
    flyctl
    fswatch
    fzf
    git
    git-lfs
    github-cli
    glow
    gum
    helm
    httpie
    hugo
    jq
    just
    kubectl
    leiningen
    less
    lsd
    pgbouncer
    python-cookiecutter
    ripgrep
    rlwrap
    shellcheck
    sqlite
    starship
    tmux
    uv
    vault
    wget
    xh
    yq
    zig
)

# Hyprland desktop: everything ~/.config/hypr references
desktop_packages=(
    hyprland
    hypridle
    hyprlock
    hyprshot
    xdg-desktop-portal-hyprland
    xdg-desktop-portal-gtk
    noctalia              # bar / launcher / lock / session menu
    polkit-gnome
    gnome-keyring
    wl-clipboard
    wl-clip-persist
    cliphist
    grim
    slurp
    satty
    wofi
    playerctl
    pamixer
    zenity                # sudo askpass prompt
    bibata-cursor-theme
    qt6ct
    ghostty
    thunar
    mpv
    quodlibet
    easyeffects
    sfizz-standalone      # sfizz_jack for Scripts/sfizz-piano.sh
)

$AUR_HELPER -S --needed --noconfirm "${cli_packages[@]}" "${desktop_packages[@]}"

# Docker needs its service running and the user in the docker group.
if ! systemctl is-enabled --quiet docker; then
    sudo systemctl enable --now docker
fi
if ! id -nG "$USER" | grep -qw docker; then
    sudo usermod -aG docker "$USER"
    echo "Added $USER to the docker group; log out and back in for it to take effect."
fi
{{- end }}
