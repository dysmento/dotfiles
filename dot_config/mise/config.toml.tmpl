[env]
_.file = '.env'
GITHUB_TOKEN = "{{ "{{" }}exec(command='gh auth token'){{ "}}" }}"

# mise manages only language runtimes and terraform — things that need
# per-project version pinning. Everything else comes from the OS package
# manager (pacman on Arch, Brewfile elsewhere) and just tracks latest.
[tools]
java = "temurin-17.0.19+10"
terraform = "1.13.3"
rust = "1.84.1"
python = "3.14.5"
go = "1.26.1"
node = "24.14.0"
elixir = "latest"
{{ if .isArch -}}
# No Arch package exists for asciidoctorj; it rides on the mise-managed java.
asciidoctorj = "latest"
{{ end -}}
# npm globals live under the mise-managed node, so they stay here.
"npm:gh-axi" = "latest"
"npm:chrome-devtools-axi" = "latest"
